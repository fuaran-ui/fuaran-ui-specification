  "divergent": [
    {
      "id": "layout-leaf-relabelled",
      "description": "a single field change on a leaf INSIDE a layout parent (the metric label). go & rs (whole-node-replace strategy) emit RemoveNode+InsertChild at the leaf's seat; py (granular field refinement) emits a single UpdateProp. All three satisfy Apply(ops, before) == after. This is the Phase 557 granularity divergence.",
      "before": {
        "id": "card",
        "kind": {
          "$type": "Box",
          "children": [
            {
              "id": "h",
              "kind": {
                "$type": "Heading",
                "level": 1,
                "text": "Sales",
                "variant": "Standard"
              }
            },
            {
              "id": "m",
              "kind": {
                "$type": "Metric",
                "label": "Revenue",
                "value": {
                  "$type": "Static",
                  "value": 1
                }
              }
            }
          ],
          "layout": {
            "$type": "Flex",
            "direction": "Vertical",
            "wrap": false
          },
          "role": "Card"
        }
      },
      "after": {
        "id": "card",
        "kind": {
          "$type": "Box",
          "children": [
            {
              "id": "h",
              "kind": {
                "$type": "Heading",
                "level": 1,
                "text": "Sales",
                "variant": "Standard"
              }
            },
            {
              "id": "m",
              "kind": {
                "$type": "Metric",
                "label": "Profit",
                "value": {
                  "$type": "Static",
                  "value": 1
                }
              }
            }
          ],
          "layout": {
            "$type": "Flex",
            "direction": "Vertical",
            "wrap": false
          },
          "role": "Card"
        }
      },
      "hosts": {
        "go": [
          {
            "$type": "RemoveNode",
            "target": "m"
          },
          {
            "$type": "InsertChild",
            "child": {
              "id": "m",
              "kind": {
                "$type": "Metric",
                "label": "Profit",
                "value": {
                  "$type": "Static",
                  "value": 1
                }
              }
            },
            "parentId": "card"
          }
        ],
        "rs": [
          {
            "$type": "RemoveNode",
            "target": "m"
          },
          {
            "$type": "InsertChild",
            "child": {
              "id": "m",
              "kind": {
                "$type": "Metric",
                "label": "Profit",
                "value": {
                  "$type": "Static",
