{
  "version": 1,
  "description": "Fuaran deterministic GFM markdown-render conformance corpus (Phase 292). Each fixture pins a markdown `source` to the canonical rendered `html` every Fuaran host (F#/Fable client, Renderer.Server, TS @fuaran-ui/renderer, Python fuaran_py.renderer) must reproduce byte-for-byte. The F# renderer (Fuaran.UI.Renderer.Markdown.toHtml in Renderer.Core) is the reference; a gate-test in each host asserts render(source) == html for every entry, so a one-byte divergence in any host turns the gate red. Feature coverage tracks the GFM spec (github.github.com/gfm) at the common-case bar; see fuaran-dotnet/docs/MARKDOWN.md for the IN/OUT/DEFERRED buckets.",
  "fixtures": [
    { "id": "heading-atx-h1", "description": "ATX heading level 1", "source": "# Title", "html": "<h1>Title</h1>\n" },
    { "id": "heading-atx-h3", "description": "ATX heading level 3", "source": "### Sub", "html": "<h3>Sub</h3>\n" },
    { "id": "heading-atx-closing", "description": "ATX heading with closing hashes", "source": "## Mid ##", "html": "<h2>Mid</h2>\n" },
    { "id": "heading-setext-h1", "description": "setext heading level 1", "source": "Title\n=====", "html": "<h1>Title</h1>\n" },
    { "id": "heading-setext-h2", "description": "setext heading level 2", "source": "Title\n-----", "html": "<h2>Title</h2>\n" },
    { "id": "paragraph-plain", "description": "plain paragraph", "source": "hello world", "html": "<p>hello world</p>\n" },
    { "id": "emphasis-strong", "description": "emphasis + strong (asterisks)", "source": "a *b* **c**", "html": "<p>a <em>b</em> <strong>c</strong></p>\n" },
    { "id": "emphasis-underscore", "description": "emphasis + strong (underscores)", "source": "_em_ __st__", "html": "<p><em>em</em> <strong>st</strong></p>\n" },
    { "id": "strikethrough", "description": "GFM strikethrough", "source": "~~gone~~", "html": "<p><del>gone</del></p>\n" },
    { "id": "code-span", "description": "inline code escapes html", "source": "`x<y & z`", "html": "<p><code>x&lt;y &amp; z</code></p>\n" },
    { "id": "backslash-escape", "description": "backslash escapes punctuation", "source": "\\*literal\\*", "html": "<p>*literal*</p>\n" },
    { "id": "link-inline", "description": "inline link", "source": "[t](http://e.com)", "html": "<p><a href=\"http://e.com\">t</a></p>\n" },
    { "id": "link-inline-title", "description": "inline link with title", "source": "[t](http://e.com \"Hi\")", "html": "<p><a href=\"http://e.com\" title=\"Hi\">t</a></p>\n" },
    { "id": "link-reference", "description": "reference link with definition", "source": "[t][ref]\n\n[ref]: http://e.com", "html": "<p><a href=\"http://e.com\">t</a></p>\n" },
    { "id": "image", "description": "inline image", "source": "![alt](http://e.com/i.png)", "html": "<p><img src=\"http://e.com/i.png\" alt=\"alt\" /></p>\n" },
    { "id": "autolink-angle", "description": "angle-bracket autolink", "source": "<http://e.com>", "html": "<p><a href=\"http://e.com\">http://e.com</a></p>\n" },
    { "id": "autolink-bare", "description": "GFM bare-URL autolink", "source": "see http://e.com here", "html": "<p>see <a href=\"http://e.com\">http://e.com</a> here</p>\n" },
    { "id": "url-javascript-neutralized", "description": "javascript: URL neutralized to about:blank", "source": "[x](javascript:alert(1))", "html": "<p><a href=\"about:blank\">x</a></p>\n" },
    { "id": "entity-amp", "description": "named entity amp decodes then re-escapes", "source": "a &amp; b", "html": "<p>a &amp; b</p>\n" },
    { "id": "entity-copy", "description": "named entity copy decodes", "source": "&copy;", "html": "<p>©</p>\n" },
    { "id": "entity-numeric", "description": "numeric (decimal) entity decodes", "source": "&#42;", "html": "<p>*</p>\n" },
    { "id": "raw-html-escaped", "description": "raw inline HTML escaped (OUT bucket)", "source": "<div>x</div>", "html": "<p>&lt;div&gt;x&lt;/div&gt;</p>\n" },
    { "id": "break-hard", "description": "hard break (two trailing spaces)", "source": "a  \nb", "html": "<p>a<br />\nb</p>\n" },
    { "id": "break-soft", "description": "soft break", "source": "a\nb", "html": "<p>a\nb</p>\n" },
    { "id": "thematic-break-dash", "description": "thematic break (dashes)", "source": "---", "html": "<hr />\n" },
    { "id": "thematic-break-star", "description": "thematic break (stars)", "source": "***", "html": "<hr />\n" },
    { "id": "code-fenced-lang", "description": "fenced code with language (CodeBlock <pre><code> shape)", "source": "```fsharp\nlet x = 1\n```", "html": "<pre><code class=\"language-fsharp\">let x = 1\n</code></pre>\n" },
    { "id": "code-fenced-nolang", "description": "fenced code without language", "source": "```\nplain\n```", "html": "<pre><code>plain\n</code></pre>\n" },
    { "id": "code-fenced-escape", "description": "fenced code escapes html", "source": "```\n<b>&\n```", "html": "<pre><code>&lt;b&gt;&amp;\n</code></pre>\n" },
    { "id": "blockquote", "description": "blockquote", "source": "> quoted", "html": "<blockquote>\n<p>quoted</p>\n</blockquote>\n" },
    { "id": "list-bullet-tight", "description": "tight bullet list", "source": "- a\n- b", "html": "<ul>\n<li>a</li>\n<li>b</li>\n</ul>\n" },
    { "id": "list-ordered-tight", "description": "tight ordered list", "source": "1. a\n2. b", "html": "<ol>\n<li>a</li>\n<li>b</li>\n</ol>\n" },
    { "id": "list-ordered-start", "description": "ordered list with custom start", "source": "3. a\n4. b", "html": "<ol start=\"3\">\n<li>a</li>\n<li>b</li>\n</ol>\n" },
    { "id": "list-task", "description": "GFM task list", "source": "- [ ] todo\n- [x] done", "html": "<ul>\n<li class=\"fuaran-task-item\"><input class=\"fuaran-task-checkbox\" disabled=\"\" type=\"checkbox\" /> todo</li>\n<li class=\"fuaran-task-item\"><input class=\"fuaran-task-checkbox\" checked=\"\" disabled=\"\" type=\"checkbox\" /> done</li>\n</ul>\n" },
    { "id": "table-gfm", "description": "GFM table (routes to fuaran-table vocabulary)", "source": "| H1 | H2 |\n| --- | --- |\n| a | b |", "html": "<table class=\"fuaran-table\"><thead><tr><th class=\"fuaran-table-header\">H1</th><th class=\"fuaran-table-header\">H2</th></tr></thead><tbody><tr class=\"fuaran-table-row\"><td class=\"fuaran-table-cell\">a</td><td class=\"fuaran-table-cell\">b</td></tr></tbody></table>\n" },
    { "id": "table-gfm-align", "description": "GFM table with column alignment", "source": "| L | C | R |\n| :-- | :-: | --: |\n| a | b | c |", "html": "<table class=\"fuaran-table\"><thead><tr><th class=\"fuaran-table-header\" align=\"left\">L</th><th class=\"fuaran-table-header\" align=\"center\">C</th><th class=\"fuaran-table-header\" align=\"right\">R</th></tr></thead><tbody><tr class=\"fuaran-table-row\"><td class=\"fuaran-table-cell\" align=\"left\">a</td><td class=\"fuaran-table-cell\" align=\"center\">b</td><td class=\"fuaran-table-cell\" align=\"right\">c</td></tr></tbody></table>\n" },
    { "id": "multiblock-heading-paragraph", "description": "heading then paragraph", "source": "# T\n\nbody", "html": "<h1>T</h1>\n<p>body</p>\n" }
  ]
}
