      },
      "expected": {
        "writes": [
          null,
          null
        ]
      }
    },
    {
      "id": "held-integral-floats",
      "description": "A held window spelled with integral floats ({\"offset\":1.0,\"count\":10.0}) IS the window (1, 10): nothing is written.",
      "input": {
