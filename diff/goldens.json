            "path": "Label",
            "target": "m",
            "value": "Profit"
          }
        ]
      }
    },
    {
      "id": "modal-interior-change",
      "description": "a text change on a Markdown leaf INSIDE a Modal (Box > Modal > Markdown). Modal carries a `children` field but is NOT one of the six layout kinds the go/py apply engines address structurally, while the rs apply engine DOES address Modal (and ScrollArea) children. So the producers diverge three ways, all satisfying Apply(ops, before) == after: go bounds recursion to the six layout kinds and whole-node-replaces the Modal at its seat in the Box (RemoveNode+InsertChild at the Modal); py likewise bounds to the six but takes the EditNode floor (carrying the Modal's whole new kind) at the Modal; rs recurses through the Modal and whole-node-replaces the interior Markdown at its seat inside the Modal. This is the documented go-bounds-to-layout-kinds vs rs-recurses-Modal/ScrollArea divergence, now encoded (py joins as a third granularity).",
      "before": {
        "id": "root",
        "kind": {
          "$type": "Box",
          "children": [
            {
              "id": "modal",
              "kind": {
                "$type": "Modal",
                "children": [
                  {
                    "id": "md",
                    "kind": {
                      "$type": "Markdown",
                      "text": "Updated hourly."
                    }
                  }
                ],
                "dismissable": true,
                "open": {
                  "$type": "Static",
                  "value": true
                }
              }
            }
          ],
          "layout": {
            "$type": "Auto"
          },
          "role": "Group"
        }
      },
      "after": {
        "id": "root",
        "kind": {
          "$type": "Box",
          "children": [
            {
              "id": "modal",
              "kind": {
                "$type": "Modal",
                "children": [
                  {
                    "id": "md",
                    "kind": {
                      "$type": "Markdown",
                      "text": "Updated daily."
                    }
                  }
                ],
                "dismissable": true,
                "open": {
                  "$type": "Static",
                  "value": true
                }
              }
            }
          ],
          "layout": {
            "$type": "Auto"
          },
          "role": "Group"
        }
      },
      "hosts": {
        "go": [
          {
            "$type": "RemoveNode",
            "target": "modal"
          },
          {
            "$type": "InsertChild",
            "child": {
              "id": "modal",
              "kind": {
                "$type": "Modal",
                "children": [
                  {
                    "id": "md",
                    "kind": {
                      "$type": "Markdown",
                      "text": "Updated daily."
                    }
                  }
                ],
                "dismissable": true,
                "open": {
                  "$type": "Static",
                  "value": true
                }
              }
            },
            "parentId": "root"
          }
        ],
        "rs": [
          {
            "$type": "RemoveNode",
            "target": "md"
          },
          {
            "$type": "InsertChild",
            "child": {
              "id": "md",
              "kind": {
                "$type": "Markdown",
                "text": "Updated daily."
              }
            },
            "parentId": "modal"
          }
        ],
        "py": [
          {
            "$type": "EditNode",
            "newKind": {
              "$type": "Modal",
              "children": [
                {
                  "id": "md",
                  "kind": {
                    "$type": "Markdown",
                    "text": "Updated daily."
                  }
                }
              ],
              "dismissable": true,
              "open": {
                "$type": "Static",
                "value": true
              }
            },
            "target": "modal"
          }
        ]
      }
    },
