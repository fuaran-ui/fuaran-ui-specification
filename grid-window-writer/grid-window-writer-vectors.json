    {
      "id": "external-write-of-the-measured-window",
      "description": "Another writer (a pager, a restored session) puts the measured window into State before the viewport does: the viewport does not write it again, and its last-written window is unchanged, so a later scroll back to the top writes again.",
      "input": {
        "windowStateKey": "grid-window",
        "steps": [
          {
            "measure": {
              "scrollTop": 0,
              "headerHeight": 40,
              "rowHeight": 32,
              "viewportHeight": 320
            }
          },
          {
            "held": {
              "offset": 1,
              "count": 10
            },
            "measure": {
              "scrollTop": 72,
              "headerHeight": 40,
              "rowHeight": 32,
              "viewportHeight": 320
            }
          },
          {
            "measure": {
              "scrollTop": 400,
              "headerHeight": 40,
              "rowHeight": 32,
              "viewportHeight": 320
            }
          },
          {
            "measure": {
              "scrollTop": 0,
              "headerHeight": 40,
              "rowHeight": 32,
              "viewportHeight": 320
            }
          }
        ]
      },
      "expected": {
        "writes": [
          {
            "offset": 0,
            "count": 10
          },
          null,
          {
            "offset": 11,
            "count": 10
          },
          {
            "offset": 0,
            "count": 10
          }
        ]
      }
    },
    {
      "id": "external-write-under-an-unchanged-viewport",
      "description": "Another writer moves State away from the window the viewport last wrote, and the viewport has not moved: nothing is written, because the measured window equals the one last written. The viewport writes again only when its own measurement changes.",
      "input": {
        "windowStateKey": "grid-window",
        "steps": [
          {
            "measure": {
              "scrollTop": 72,
              "headerHeight": 40,
              "rowHeight": 32,
              "viewportHeight": 320
            }
          },
          {
            "held": {
              "offset": 5,
              "count": 10
