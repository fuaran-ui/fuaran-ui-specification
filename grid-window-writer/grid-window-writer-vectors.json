    {
      "id": "held-window-is-not-written-again",
      "description": "A window State already holds is not written again: the seeded (1, 10) is what the viewport measures at both steps.",
      "input": {
        "windowStateKey": "grid-window",
        "held": {
          "offset": 1,
          "count": 10
        },
        "steps": [
          {
            "measure": {
              "scrollTop": 72,
              "headerHeight": 40,
              "rowHeight": 32,
              "viewportHeight": 320
            }
