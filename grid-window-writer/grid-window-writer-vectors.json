    {
      "id": "fractional-figures",
      "description": "Fractional pixel figures: (500 - 41.25) / 33.5 floors to row 13, and 400 / 33.5 rounds up to a count of 12.",
      "input": {
        "windowStateKey": "grid-window",
        "steps": [
          {
            "measure": {
