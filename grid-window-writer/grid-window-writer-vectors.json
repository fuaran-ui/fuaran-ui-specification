          }
        ]
      }
    },
    {
      "id": "unmeasurable-falls-back-to-defaults",
      "description": "Nothing measurable (no row rendered, no layout): the writer assumes 32px rows and a 480px viewport, so scroll offset 64 is row 2 and the count is 15.",
      "input": {
        "windowStateKey": "grid-window",
        "steps": [
          {
            "measure": {
              "scrollTop": 64,
              "headerHeight": 0
            }
          }
